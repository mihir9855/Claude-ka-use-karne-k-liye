//@version=6
strategy("Breakout + Volume (template)", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0.05,
         slippage=2, pyramiding=0)

// --- Inputs (apne setup ke hisab se badlo) ---
lookback  = input.int(20,  "Breakout lookback")
volMult   = input.float(1.5, "Volume multiplier vs avg", step=0.1)
rr        = input.float(2.0, "Reward:Risk", minval=1.0, step=0.1)
setupName = input.string("breakout", "Setup name (alert JSON)")

// --- Logic ---
resistance = ta.highest(high, lookback)[1]
support    = ta.lowest(low, lookback)[1]
volOk      = volume > ta.sma(volume, lookback) * volMult
trendUp    = close > ta.ema(close, 50)
longSig    = close > resistance and volOk and trendUp and strategy.position_size == 0

stopPx   = support                 // invalidation level
riskPerU = close - stopPx
tgtPx    = close + riskPerU * rr

if longSig and riskPerU > 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit", "Long", stop=stopPx, limit=tgtPx)

plot(resistance, "Resistance", color=color.red)
plot(support, "Support/Stop", color=color.green)
plotshape(longSig, "Signal", shape.triangleup, location.belowbar, color.lime, size=size.small)

// --- Webhook-ready alert (JSON) ---
// Alert dialog me: Condition = is script ko chuno, "Any alert() function call", Webhook URL ON.
if longSig and riskPerU > 0
    alert('{"ticker":"' + syminfo.ticker + '","price":"' + str.tostring(close) +
          '","timeframe":"' + timeframe.period + '","setup":"' + setupName +
          '","stop":"' + str.tostring(stopPx) + '","target":"' + str.tostring(tgtPx) + '"}',
          alert.freq_once_per_bar_close)
